# Для сервера: скопируйте в .env и заполните. Для локального запуска — .env.local.example
DJANGO_ENV=prod
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=results.example.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://results.example.kz
PUBLIC_BASE_URL=https://results.example.kz
# 1, если сайт открывается по HTTPS (TLS терминирует внешний прокси)
DJANGO_SECURE_COOKIES=1
# AlfaCRM: адрес вида demo.s20.online, e-mail и API-ключ из профиля, код поля для ссылки (обычно custom_*)
ALFACRM_HOST=
ALFACRM_EMAIL=
ALFACRM_API_KEY=
ALFACRM_LINK_FIELD=
# Порт на хосте
HTTP_PORT=80
