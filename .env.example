# Скопируйте в .env и заполните
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=results.example.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://results.example.kz
PUBLIC_BASE_URL=https://results.example.kz
# 1, если сайт открывается по HTTPS (TLS терминирует внешний прокси)
DJANGO_SECURE_COOKIES=1
# Порт на хосте
HTTP_PORT=80
